rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isTeacher() { return signedIn() && userDoc(request.auth.uid).role == 'teacher'; }

    function isEnrolled(classId) {
      return exists(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
                    && request.resource.data.role in ['teacher', 'student'];
      // role can never change after registration
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // Only the owning teacher and enrolled students can read a class, so join
    // codes are not visible to everyone. Joining goes through the joinClass function.
    match /classes/{classId} {
      allow read: if signedIn()
                  && (resource.data.teacherID == request.auth.uid || isEnrolled(classId));
      allow create: if isTeacher() && request.resource.data.teacherID == request.auth.uid;
      // owner can rename; ownership and join code never change
      allow update: if resource.data.teacherID == request.auth.uid
                    && request.resource.data.teacherID == resource.data.teacherID
                    && request.resource.data.joinCode == resource.data.joinCode;
      allow delete: if resource.data.teacherID == request.auth.uid;
    }

    // Doc id is classId_studentId: one enrollment per student per class.
    // Created only by the joinClass Cloud Function (it checks the join code).
    match /enrollments/{id} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.studentID == request.auth.uid;
    }

    // Sessions are created by the startSession Cloud Function only (server-set times).
    match /attendance_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, delete: if false;
      // teacher may only close their own session early
      allow update: if resource.data.teacherID == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'closed';

      // questions WITHOUT answers: any signed-in user (enrolled students) can read
      match /questions/{q} {
        allow read: if signedIn();
        allow write: if false;
      }
      // correct answers: nobody from the client (Cloud Function uses admin SDK)
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // Written by the submitAttendance Cloud Function only.
    // A student reads only their own records (they contain GPS); the teacher
    // reads the records of their sessions. Queries must filter on
    // studentID == uid or teacherID == uid to match these rules.
    match /attendance_records/{id} {
      allow read: if signedIn()
                  && (resource.data.studentID == request.auth.uid
                      || resource.data.teacherID == request.auth.uid);
      allow write: if false;
    }
  }
}
