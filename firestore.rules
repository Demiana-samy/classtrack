rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isTeacher() { return signedIn() && userDoc(request.auth.uid).role == 'teacher'; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
                    && request.resource.data.role in ['teacher', 'student'];
      // role can never change after registration
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherID == request.auth.uid;
      allow update, delete: if resource.data.teacherID == request.auth.uid;
    }

    // Doc id must be classId_studentId: one enrollment per student per class.
    match /enrollments/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.studentID == request.auth.uid
                    && id == request.resource.data.classID + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.studentID == request.auth.uid;
    }

    // Sessions are created by the startSession Cloud Function only (server-set times).
    match /attendance_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, delete: if false;
      // teacher may only close their own session early
      allow update: if resource.data.teacherID == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'closed';

      // questions WITHOUT answers: any signed-in user (enrolled students) can read
      match /questions/{q} {
        allow read: if signedIn();
        allow write: if false;
      }
      // correct answers: nobody from the client (Cloud Function uses admin SDK)
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // Attendance records are written by the submitAttendance Cloud Function only.
    match /attendance_records/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
